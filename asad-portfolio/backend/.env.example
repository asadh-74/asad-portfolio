# Port the API listens on
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Add your deployed frontend URL(s) here.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Optional: email delivery for the contact form ---
# If these are left blank, contact form messages are still saved to
# backend/data/messages.json so nothing is lost - you just won't get an email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password
CONTACT_TO_EMAIL=asadh1521@gmail.com

# --- Optional: AI assistant on the site ---
# If left blank, the AI assistant widget shows a friendly "not configured"
# message and the rest of the site keeps working normally.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

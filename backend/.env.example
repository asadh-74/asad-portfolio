# Port the API listens on
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Add your deployed frontend URL(s) here.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Optional: email delivery for the contact form ---
# If these are left blank, contact form messages are still saved to
# backend/data/messages.json so nothing is lost - you just won't get an email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password
CONTACT_TO_EMAIL=asadh152i@gmail.com
